{
  "manifest_version": 2,
  "name": "LinkGuard - Universal URL Protection",
  "version": "1.0.0",
  "description": "Universal URL scanner that works in all browsers. Scan URLs for threats and malware protection.",
  
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "scripts": ["background-universal.js"],
    "persistent": false
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-universal.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  
  "browser_action": {
    "default_popup": "popup-universal.html",
    "default_title": "LinkGuard - Scan URLs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    "linkguard-universal.html",
    "icons/*"
  ],
  
  "content_security_policy": "script-src 'self' 'unsafe-inline'; object-src 'self'"
}